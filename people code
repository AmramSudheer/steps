//status evaluator
Local string &status; 
Local boolean &isActive; 
&status = ZZ_TRAINING_REC.STATUS.Value; 
 
If &status = "A" Then 
   &isActive = True; 
Else 
   &isActive = False; 
End-If; 
 
If &isActive Then 
   MessageBox(0, "", 0, 0, "Employee is active"); 
Else 
   MessageBox(0, "", 0, 0, "Employee is inactive"); 
End-If; 
===========================================

//grading logic
Local number &marks; 
Local string &grade; 
&marks = ZZ_TRAINING_REC.MARKS.Value; 
If &marks >= 75 Then 
   &grade = "A"; 
Else 
   If &marks >= 50 Then 
      &grade = "B"; 
   Else 
      &grade = "C"; 
   End-If; 
End-If; 
 
MessageBox(0, "", 0, 0, "Grade = " | &grade); 
===========================================

//access control check
Local string &role; 
Local number &trainingHours; 
Local boolean &accessRequested; 
&role = ZZ_TRAINING_REC.ROLE.Value; 
&trainingHours = ZZ_TRAINING_REC.TRAINING_HRS.Value; 
&accessRequested = ZZ_TRAINING_REC.ACCESS_REQ.Value; 
 
If &accessRequested And 
      &role = "ADMIN" And 
      &trainingHours >= 8 Then 
   MessageBox(0, "", 0, 0, "Access can be approved"); 
Else 
   MessageBox(0, "", 0, 0, "Access requirements are not complete"); 
End-If; 


