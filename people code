//age check
Local number &age; 
&age = ZZ_TRAINING_REC.AGE.Value; 
 
If &age >= 18 Then 
   MessageBox(0, "", 0, 0, "Eligible for employment"); 
Else 
   MessageBox(0, "", 0, 0, "Not eligible for employment"); 
End-If; 

