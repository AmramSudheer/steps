//salary bonus calculation
Local number &salary; 
Local number &bonus; 
&salary = ZZ_TRAINING_REC.SALARY.Value; 
 
If &salary >= 50000 Then 
   &bonus = &salary * 0.10; 
Else 
   &bonus = &salary * 0.05; 
End-If; 
 
MessageBox(0, "", 0, 0, "Bonus amount = " | &bonus); 
